# Variable NAMES only. Never put real values in this file or in the chat.
# Real values go in: Vercel → Project → Settings → Environment Variables
# (and, if a tool in the cloud session needs one, the cloud environment's variables).

# Supabase (web app + dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses row level security: use only where unavoidable, always filtered by owner.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated emails allowed into the owner dashboard. Empty = nobody (fails closed).
OWNER_EMAILS=

# Optional: transcripts for tools/video-digest.sh when local Whisper is unavailable,
# and AI features in web/lib/ai.ts
OPENAI_API_KEY=

# Optional: transactional email (booking confirmations, new sign-up alerts)
RESEND_API_KEY=
